<?xml version="1.0" encoding="utf-8"?>
<!-- The mark: one unbroken D stroke, white on solid Deluge blue. Nothing else — the inner
     arc read as decoration at launcher icon sizes, and the gradient read as a placeholder. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Stem and bowl, one path: down the left, out along the top, around the right, back. -->
    <path
        android:pathData="M40,32 L40,76"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="13"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M40,32 L53,32 A22,22 0 0 1 53,76 L40,76"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="13"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
