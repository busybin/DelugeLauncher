<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Tapping the clock widget opens the alarm app. Some OEM clocks gate their own
         SHOW_ALARMS activity behind this, and it is granted at install with no prompt. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- The reflection fallback for opening the notification shade goes through the system
         service, which checks this permission on the caller. Removed once as supposedly
         dead — swipe-down shade died on a phone with no accessibility service the same
         day — so it stays: on builds that grant or bypass it for the home app, this line
         is the difference between working and a toast. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- A launcher must be able to see every installed app, icon pack, and widget provider
         on the device; without this, PackageManager silently filters almost everything out
         on Android 11+. This is one of Google's own documented justified uses of the permission. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Android 15 hides a private space from every app that does not ask for this. Without
         it the profile is missing from LauncherApps entirely, so its apps can never be listed
         and the space can never be unlocked from here. Granted at install time, no prompt,
         and it only takes effect while this launcher holds the home role. -->
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" />
    <!-- Since Android 8, asking the system to uninstall another package needs this. Without it
         ACTION_DELETE resolves to nothing and the tap does nothing at all. Granted at install,
         no prompt, and it only lets the system's own uninstaller be opened. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Asked for at the moment the clock widget is set to show what is coming up, never at
         install. Read only, and nothing read here leaves the phone: there is no network
         permission to send it with. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- The flashlight, asked for the first time the corner button is set to it rather than at
         install: setTorchMode holds the camera open for as long as the light is on. Nothing is
         captured, and no picture ever leaves the device. Declared even though most launchers
         never need it — an undeclared runtime permission is denied before it is ever asked. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- No camera of our own is required, so a device without one can still install this. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".DelugeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.DelugeLauncher"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.DelugeLauncher"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.WidgetPickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.DelugeLauncher" />

        <!-- The one component another app can reach, and the only way in is the system
             raising it on behalf of an app that asked for a shortcut to be pinned. It is
             answered and gone, so it stays out of recents and off the back stack, and it
             keeps its own task affinity rather than joining the HOME task it appears over. -->
        <activity
            android:name=".shortcut.PinShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.DelugeLauncher.PinShortcut">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.DelugeAccessibilityService"
            android:exported="true"
            android:label="Deluge Launcher gestures"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- The clock widget's own settings. Exported because the system starts it on behalf
             of whichever launcher is showing the widget, including this one. -->
        <activity
            android:name=".widget.ClockWidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.DelugeLauncher">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The launcher's own clock widget. Exported because every widget provider is: the
             system reads it on behalf of whichever host is showing it. -->
        <receiver
            android:name=".widget.ClockWidgetProvider"
            android:exported="true"
            android:label="@string/widget_clock_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock_info" />
        </receiver>

        <!-- Weather from whichever app already fetches it. Exported because the sender has to
             be able to reach it, and disabled until a widget is actually set to show weather:
             a receiver a stranger can reach should not exist while the feature is off. -->
        <receiver
            android:name=".widget.ClockWidgetWeatherReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="nodomain.freeyourgadget.gadgetbridge.ACTION_GENERIC_WEATHER" />
            </intent-filter>
        </receiver>

        <service
            android:name=".media.NowPlayingListenerService"
            android:exported="true"
            android:label="Deluge Launcher Now Playing"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
