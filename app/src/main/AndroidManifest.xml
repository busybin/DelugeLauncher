<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The one thing this app asks the network for: reading the release page to see whether a
         newer version exists. Nothing is sent — no setting, no app list, no usage — and
         data/UpdateChecker.kt is the only caller. Read-only, and an update is only ever
         reported: the download and the install both happen outside this app, in the browser
         and the system's own installer. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Tapping the clock widget opens the alarm app. Some OEM clocks gate their own
         SHOW_ALARMS activity behind this, and it is granted at install with no prompt. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- The reflection fallback for opening the notification shade goes through the system
         service, which checks this permission on the caller. Removed once as supposedly
         dead — swipe-down shade died on a phone with no accessibility service the same
         day — so it stays: on builds that grant or bypass it for the home app, this line
         is the difference between working and a toast. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- A launcher must be able to see every installed app, icon pack, and widget provider
         on the device; without this, PackageManager silently filters almost everything out
         on Android 11+. This is one of Google's own documented justified uses of the permission. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Android 15 hides a private space from every app that does not ask for this. Without
         it the profile is missing from LauncherApps entirely, so its apps can never be listed
         and the space can never be unlocked from here. Granted at install time, no prompt,
         and it only takes effect while this launcher holds the home role. -->
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" />
    <!-- Since Android 8, asking the system to uninstall another package needs this. Without it
         ACTION_DELETE resolves to nothing and the tap does nothing at all. Granted at install,
         no prompt, and it only lets the system's own uninstaller be opened. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Asked for at the moment the clock widget is set to show what is coming up, never at
         install. Read only, and nothing read here leaves the phone: the app's one network
         call goes the other way, reading the release page for a newer version. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- The automatic freeze needs to hear the screen go off, which is a broadcast only a
         registered receiver is given. That means a service that stays up, and a foreground
         service is the only kind the system leaves alone long enough to be worth anything.
         It runs only while the user has turned the feature on, and says so with a
         notification the whole time. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- The watcher's ongoing notification is the only sign that something is running in the
         background; without this it is silently dropped on Android 13 and newer. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The watcher above is a service, and a boot broadcast is the one moment the system
         lets an app start one from the background. Without this, automatic freezing stayed
         off until the launcher was opened once after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The flashlight, asked for the first time the corner button is set to it rather than at
         install: setTorchMode holds the camera open for as long as the light is on. Nothing is
         captured, and no picture ever leaves the device. Declared even though most launchers
         never need it — an undeclared runtime permission is denied before it is ever asked. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- No camera of our own is required, so a device without one can still install this. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".DelugeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.DelugeLauncher"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.DelugeLauncher"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Actions the dynamic freeze shortcuts send; see FreezeShortcuts. -->
            <intent-filter>
                <action android:name="dev.delugelauncher.action.FREEZE_ALL" />
                <action android:name="dev.delugelauncher.action.UNFREEZE_ALL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.WidgetPickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.DelugeLauncher" />

        <!-- The one component another app can reach, and the only way in is the system
             raising it on behalf of an app that asked for a shortcut to be pinned. It is
             answered and gone, so it stays out of recents and off the back stack, and it
             keeps its own task affinity rather than joining the HOME task it appears over. -->
        <activity
            android:name=".shortcut.PinShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.DelugeLauncher.PinShortcut">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.DelugeAccessibilityService"
            android:exported="true"
            android:label="Deluge Launcher gestures"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- The clock widget's own settings. Exported because the system starts it on behalf
             of whichever launcher is showing the widget, including this one. -->
        <activity
            android:name=".widget.ClockWidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.DelugeLauncher">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The launcher's own clock widget. Exported because every widget provider is: the
             system reads it on behalf of whichever host is showing it. -->
        <receiver
            android:name=".widget.ClockWidgetProvider"
            android:exported="true"
            android:label="@string/widget_clock_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock_info" />
        </receiver>

        <!-- Weather from whichever app already fetches it. Exported because the sender has to
             be able to reach it, and disabled until a widget is actually set to show weather:
             a receiver a stranger can reach should not exist while the feature is off. -->
        <receiver
            android:name=".widget.ClockWidgetWeatherReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="nodomain.freeyourgadget.gadgetbridge.ACTION_GENERIC_WEATHER" />
            </intent-filter>
        </receiver>

        <!-- Shizuku hands its binder to apps through this provider. Exported because the
             Shizuku app must reach it; the permission makes it callable only by a process
             holding INTERACT_ACROSS_USERS_FULL, which is Shizuku itself. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <service
            android:name=".media.NowPlayingListenerService"
            android:exported="true"
            android:label="Deluge Launcher Now Playing"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Up only while the user has automatic freezing on. Not exported: nothing outside
             the app has any business starting or stopping it. -->
        <service
            android:name=".service.FreezeAutoService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Watches for the screen going off to apply the user's freeze list." />
        </service>

        <!-- Starts that service again after a reboot; see the receiver. -->
        <receiver
            android:name=".service.FreezeBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- One tap in the shade: freeze the whole list, or lift it. The system binds this
             one, hence the permission and the export. -->
        <service
            android:name=".service.FreezeTileService"
            android:exported="true"
            android:icon="@drawable/ic_freeze_notification"
            android:label="@string/freeze_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- The target of a pinned freeze shortcut: no UI, finishes at once. Exported because
             the launcher starts shortcut intents as itself, not as the publisher. The worst a
             stranger can do with it is toggle an app the user already put on the list. -->
        <activity
            android:name=".FreezeToggleActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    </application>
</manifest>
